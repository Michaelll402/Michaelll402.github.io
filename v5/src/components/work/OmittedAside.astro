---
// replay-chapter.md — the quiet aside for honestly omitted chapters.
interface Props {
  label: string;
  note: string;
}
const { label, note } = Astro.props;
---

<aside class="omitted" aria-label={`Omitted chapters: ${label}`}>
  <p class="t-mono-s omitted-label">{label}</p>
  <p class="omitted-note">{note}</p>
</aside>

<style>
  .omitted {
    margin-top: var(--space-chapter);
    border-left: var(--rule-strong) solid var(--line);
    padding-left: var(--space-5);
    max-width: var(--measure);
  }
  .omitted-label {
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: var(--track-eyebrow);
    margin: 0;
  }
  .omitted-note {
    color: var(--ink-2);
    font-size: var(--text-body-s);
    line-height: var(--leading-body);
    margin: var(--space-3) 0 0;
  }
</style>
