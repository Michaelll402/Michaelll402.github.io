---
/* The five things Michael does away from the keyboard.

   The words are already in the About paragraph, verbatim and locked — this is a
   visual index of that same sentence, not new copy. Nothing here claims
   anything the paragraph does not already say.

   Built entirely from vocabulary the site already owns: the lens-rimmed glass
   pod from the navigation, the four project accents plus one, and monoline
   marks drawn to the same 24×24 grid and 1.5 stroke as the nav's section
   marks. Nothing new was invented to make this look designed. */
const pursuits = [
  {
    label: "Football",
    accent: "var(--acc-support)",
    // a ball: circle, centre panel, seams running to the edge
    d: "M12 3.7a8.3 8.3 0 1 1 0 16.6 8.3 8.3 0 0 1 0-16.6ZM12 8.2l3.3 2.4-1.3 3.9h-4l-1.3-3.9ZM12 3.7v4.5M15.3 10.6l4.3-1.4M14 14.5l2.6 3.6M10 14.5l-2.6 3.6M8.7 10.6 4.4 9.2",
  },
  {
    label: "Running",
    accent: "var(--acc-vision)",
    // a runner mid-stride
    d: "M14.7 4.3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM9.1 20.3l2.5-4.7-2-2.2.9-4.5 2.9-1.5 2.7 1.4 2.3.5M11.6 15.6l3.6 1.5 1.2 3.2M6.3 9.9l3.1-1.6M4.5 13.3h3.3",
  },
  {
    label: "Cycling",
    accent: "var(--acc-simiutopia)",
    // two wheels and a frame
    d: "M6 12.2a3.2 3.2 0 1 1 0 6.4 3.2 3.2 0 0 1 0-6.4ZM18 12.2a3.2 3.2 0 1 1 0 6.4 3.2 3.2 0 0 1 0-6.4ZM6 15.4l3.5-5.3h4.2M9.5 10.1 18 15.4M13.7 10.1l1.7 5.3M8.7 8.3h2.5",
  },
  {
    label: "Swimming",
    accent: "var(--acc-subways)",
    // a swimmer, and the water
    d: "M9.2 5.8a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8ZM4.3 12.7l3.9-2.4 3.4 1.8 3.4-2.9 3 2.1M3.2 16.6c1.5 0 1.5 1.2 2.9 1.2s1.5-1.2 2.9-1.2 1.5 1.2 2.9 1.2 1.5-1.2 3-1.2 1.4 1.2 2.9 1.2 1.5-1.2 2.9-1.2M3.2 19.7c1.5 0 1.5 1.2 2.9 1.2s1.5-1.2 2.9-1.2 1.5 1.2 2.9 1.2 1.5-1.2 3-1.2 1.4 1.2 2.9 1.2 1.5-1.2 2.9-1.2",
  },
  {
    label: "Coffee",
    accent: "var(--acc-support-deep)",
    // a cup worth arguing about
    d: "M4.6 9.6h12v4.9a4 4 0 0 1-4 4H8.6a4 4 0 0 1-4-4ZM16.6 10.9h1.5a2.4 2.4 0 0 1 0 4.8h-1.5M3.4 21.2h14.4M8.7 6.7c0-1.1 1-1.4 1-2.5M12.1 6.7c0-1.1 1-1.4 1-2.5",
  },
];
---

<div class="pursuits" aria-label="Away from the keyboard">
  <ul class="pursuit-row">
    {
      pursuits.map((p) => (
        <li class="pursuit" style={`--p-acc: ${p.accent}`}>
          <span class="pursuit-pod">
            <span class="pursuit-spec" aria-hidden="true" />
            <svg class="pursuit-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={p.d} />
            </svg>
          </span>
          <span class="pursuit-label t-mono-s">{p.label}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .pursuits {
    margin-top: var(--space-7);
  }
  .pursuit-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .pursuit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  /* the same glass the navigation is made of: a translucent body, a rim lit
     along the top, and a specular that only exists on a fine pointer */
  .pursuit-pod {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    background:
      linear-gradient(168deg, color-mix(in srgb, var(--ink) 11%, transparent), transparent 58%),
      color-mix(in srgb, var(--void) 42%, transparent);
    border: var(--hairline) solid color-mix(in srgb, var(--ink) 13%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--ink) 24%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--void) 50%, transparent),
      0 12px 26px -20px rgba(0, 0, 0, 0.8);
    transition:
      transform 520ms var(--ease-out-expo),
      border-color var(--dur-medium) var(--ease-smooth);
  }
  /* THE LENS: the rim brightens whatever sits under it, which is what makes the
     pod read as a solid object rather than a painted circle. Same construction
     as the navigation. */
  .pursuit-pod::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    border: 2px solid transparent;
    -webkit-backdrop-filter: brightness(1.18) saturate(1.8);
    backdrop-filter: brightness(1.18) saturate(1.8);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  /* the pursuit's own light, held behind the glass */
  .pursuit-spec {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    background: radial-gradient(70% 70% at 50% 118%, var(--p-acc), transparent 72%);
    transition: opacity var(--dur-medium) var(--ease-smooth);
  }

  .pursuit-mark {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke var(--dur-medium) var(--ease-smooth);
  }
  .pursuit-label {
    color: var(--ink-3);
    text-transform: uppercase;
    transition: color var(--dur-medium) var(--ease-smooth);
  }

  .pursuit:hover .pursuit-pod,
  .pursuit:focus-within .pursuit-pod {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--p-acc) 45%, transparent);
  }
  .pursuit:hover .pursuit-spec,
  .pursuit:focus-within .pursuit-spec {
    opacity: 0.55;
  }
  .pursuit:hover .pursuit-mark,
  .pursuit:focus-within .pursuit-mark {
    stroke: var(--ink);
  }
  .pursuit:hover .pursuit-label,
  .pursuit:focus-within .pursuit-label {
    color: var(--ink);
  }

  /* Day needs its own rim, not the navigation's. Up in the bar the white edge
     works because it sits against the aura; down here the ground is #edebe5 and
     a white rim on it is simply invisible — measured, and the pods vanished.
     Frosted glass on a light ground reads by its shadow and a soft dark edge. */
  :global(html[data-mode="day"]) .pursuit-pod {
    background:
      linear-gradient(168deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.6) 60%),
      rgba(255, 255, 255, 0.5);
    border-color: color-mix(in srgb, var(--ink) 14%, transparent);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(20, 20, 26, 0.06),
      0 10px 20px -14px rgba(20, 20, 26, 0.3);
  }
  /* the lens brightens what is under it, which does nothing over a light
     ground — in day it earns its keep by deepening the edge instead */
  :global(html[data-mode="day"]) .pursuit-pod::after {
    -webkit-backdrop-filter: brightness(0.96) saturate(1.5);
    backdrop-filter: brightness(0.96) saturate(1.5);
  }
  :global(html[data-mode="day"]) .pursuit-mark {
    stroke: var(--ink-2);
  }

  @media (max-width: 1023px) {
    .pursuit-row {
      gap: var(--space-4);
      justify-content: space-between;
    }
    .pursuit-pod {
      width: 52px;
      height: 52px;
    }
    .pursuit-mark {
      width: 23px;
      height: 23px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pursuit-pod,
    .pursuit-spec,
    .pursuit-mark,
    .pursuit-label {
      transition: none;
    }
    .pursuit:hover .pursuit-pod {
      transform: none;
    }
  }
</style>
